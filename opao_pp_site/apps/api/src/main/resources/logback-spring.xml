<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <property name="LOG_PATH" value="logs" />
    <property name="LOG_FILE" value="pp-api-security-audit" />

    <!-- 1. CONSOLE APPENDER -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi> 
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. SECURE JSON FILE APPENDER -->
    <appender name="SECURE_JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.json</file>
        
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSX,UTC}","level":"%level","tier":"%mdc{tier}","trackingId":"%mdc{trackingId}","logger":"%logger","message":"%msg"}%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/${LOG_FILE}-%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
            <maxFileSize>10MB</maxFileSize>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- 💡 3. THE FIX: SILENCE SPRING'S DUPLICATE EXCEPTION RESOLVER LOGS COMPLETELY -->
    <!-- This stops the duplicate line that lacks a trackingId or tier property -->
    <logger name="org.springframework.web.servlet.mvc.method.annotation.ExceptionHandlerExceptionResolver" level="OFF" />

    <!-- 4. ROOT LEVEL ROUTING LAYERS -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="SECURE_JSON_FILE" />
    </root>
</configuration>
