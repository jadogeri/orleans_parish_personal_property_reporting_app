<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <property name="LOG_PATH" value="logs" />
    <property name="LOG_FILE" value="pp-api-security-audit" />

    <!-- 1. CONSOLE APPENDER -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi> 
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. SECURE JSON FILE APPENDER -->
    <appender name="SECURE_JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.json</file>
        
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSX,UTC}","level":"%level","tier":"%mdc{tier}","trackingId":"%mdc{trackingId}","logger":"%logger","message":"%msg"}%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/${LOG_FILE}-%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
            <maxFileSize>10MB</maxFileSize>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 💡 3. FORCE YOUR CUSTOM EXCEPTIONS TIERS DIRECTLY TO BOTH STREAM OUTPUTS -->
    <!-- This guarantees your business errors write to the JSON file no matter what framework alerts occur -->
    <logger name="com.opao.pp_api.common.exceptions" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="SECURE_JSON_FILE" />
    </logger>

    <!-- 💡 4. THE FILTER: Routes framework alerts to console, but blocks them from the root file -->
    <logger name="org.springframework" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="org.springdoc" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- 5. ROOT ROUTING SCHEMAS -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
